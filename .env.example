# Neon (https://neon.tech) — conexão pooled (recomendada p/ serverless)
# Projeto → Connect → escolha "Pooled connection" e "Transaction"
DATABASE_URL="postgresql://NEON_USER:SENHA@ep-xxx-pooler.us-east-2.aws.neon.tech/agendou?sslmode=require"

# Conexão direta — usada pelo Prisma em migrations (`prisma migrate deploy`)
DIRECT_URL="postgresql://NEON_USER:SENHA@ep-xxx.us-east-2.aws.neon.tech/agendou?sslmode=require"

